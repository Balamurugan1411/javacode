class Solution {
    public int[] shuffle(int[] nums, int n) {
        int i = 0, j = n;
        int k = 0;

        int[] arr = new int[nums.length];

        while (j < nums.length) {
            arr[k++] = nums[i];  
            arr[k++] = nums[j];  
            i++;
            j++;
        }

        return arr;
    }
}