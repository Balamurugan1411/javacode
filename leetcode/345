class Solution {
    public static boolean isVowel(char ch) {
    
    if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U') {
        return true;
    } else {
        return false;
    }
}

    public String reverseVowels(String s) {
        int l=s.length()-1;
        int i=0;
        char[] ch=s.toCharArray();
        while(i<=l){
            if(isVowel(ch[i])&&isVowel(ch[l])){
                char temp=ch[i];
                ch[i]=ch[l];
                ch[l]=temp;
                i++;
                l--;
                continue;
            }
            else if(isVowel(ch[i])){
                l--;
                continue;
            }
            else if(isVowel(ch[l])){
                i++;
                continue;
            }
            
           else if(!(isVowel(ch[i])&&isVowel(ch[l]))){
            i++;
            l--;
            continue;
           }

        }

        String str=new String(ch);
        return str;
    }
}